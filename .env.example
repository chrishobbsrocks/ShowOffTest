# Copy this file to .env.local and fill in real values for local
# development (never commit .env.local — see .gitignore).
#
# Local development points at the local Supabase stack (`npm run db:start`),
# never production — see CLAUDE.md, "Local development database". Run
# `npx supabase status` after `npm run db:start` to print this project's
# local URL and keys, which is where these local values come from.
#
# In Vercel, these four are set in the Production environment only (D-56);
# Pipeman never sees or sets their values. These are the complete set — a
# sprint that finds it needs another variable stops and raises it with
# Master Controller rather than adding one here (D-57).

# Accepts either the newer sb_publishable_... / sb_secret_... key format or
# legacy anon / service-role keys — both work with the Supabase client
# libraries this project uses.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=
